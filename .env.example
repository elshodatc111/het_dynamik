# Nusxa oling: copy .env.example .env   (Windows)   yoki   cp .env.example .env
DJANGO_SECRET_KEY=bu-yerga-uzun-tasodifiy-satr-yozing
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Reverse proxy (Nginx Proxy Manager) orqali HTTPS bo‘lsa: https://dinamika.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=

# Baza: mysql yoki sqlite (sqlite faqat sinov uchun)
DB_ENGINE=mysql
DB_NAME=dinamika
DB_USER=dinamika
DB_PASSWORD=parol
DB_HOST=127.0.0.1
DB_PORT=3306

# Birinchi admin (python manage.py bootstrap_admin shu qiymatlarni o‘qiydi)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=
